DEBUG=True
SECRET_KEY=django-insecure-shopify-taxonomy-classifier-prototype-key-2026
ALLOWED_HOSTS=*

# Database: SQLite fallback by default. For MariaDB / MySQL set DATABASE_URL or db credentials
# DATABASE_URL=mysql://user:password@localhost:3306/shopify_classifier
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional AI / LLM API Key (System operates in Demo Hybrid Mode if omitted)
AI_API_KEY=
AI_MODEL_PROVIDER=openai

# Batch Processing
BATCH_SIZE=50
MAX_CONCURRENT_REQUESTS=10
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.60
